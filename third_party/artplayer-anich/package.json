    },
    "./legacy": {
      "types": "./types/artplayer.d.ts",
      "import": "./dist/artplayer.legacy.js",
      "require": "./dist/artplayer.legacy.js"
    }
  },
  "main": "./dist/artplayer.js",
  "module": "./dist/artplayer.mjs",
  "types": "./types/artplayer.d.ts",
  "legacy": "./dist/artplayer.legacy.js",
  "browserslist": "last 1 Chrome version",
  "dependencies": {
    "option-validator": "^2.0.6"
  },
  "anich": {
    "source": "https://github.com/Ming-QWQ520/ArtPlayer/releases/download/anich-edition-wip/anichsdk.zip",
    "branch": "WIP",
    "commit": "3cf6cac4",
    "bundledAt": "2026-08-28"
  }
