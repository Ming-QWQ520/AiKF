{
  "name": "artplayer",
  "version": "5.4.1-anich.1",
  "description": "ArtPlayer.js (Anich Edition) — bundled Anich SDK + danmaku-first preset",
  "author": "Harvey Zhao <laozhaochaguan@gmail.com>",
  "license": "MIT",
  "homepage": "https://artplayer.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ming-QWQ520/ArtPlayer.git"
  },
  "bugs": {
    "url": "https://github.com/Ming-QWQ520/ArtPlayer/issues"
  },
  "keywords": [
    "html5",
    "video",
    "player",
    "anich",
    "danmaku"
  ],
  "exports": {
    ".": {
      "types": "./types/artplayer.d.ts",
      "import": "./dist/artplayer.mjs",
