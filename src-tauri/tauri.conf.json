{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiKF",
  "version": "0.1.0",
  "identifier": "com.ming.aikf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AiKF",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "shadow": true,
        "devtools": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Ming",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "templates/installer.nsi",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "images/header.bmp",
        "sidebarImage": "images/sidebar.bmp",
        "uninstallerHeaderImage": "images/header.bmp",
        "installMode": "perMachine"
      }
    }
  }
}
